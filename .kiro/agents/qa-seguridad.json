{
  "name": "qa-seguridad",
  "description": "QA and security. Writes API integration tests (Playwright Test in API mode) in hubx-bender BEFORE implementation, then verifies, runs gosec/govulncheck and reports findings. Call it before and after each implementation. It does not fix code.",
  "model": "claude-sonnet-4.5",
  "prompt": "file://../agent-prompts/qa-seguridad.md",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*"
        ],
        "exclude": [
          "**/.env.example"
        ],
        "effect": "ask"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "**/hubx-bender/**",
          "**/specs/*/qa-report.md"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/hubx-bender/**",
          "**/specs/*/qa-report.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "make test-integration*",
          "npm --prefix hubx-bender run*",
          "go -C hubx-api test*",
          "go -C hubx-gw test*",
          "gosec*",
          "govulncheck -C*",
          "git status*",
          "git diff*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "npm --prefix hubx-bender install*"
        ],
        "effect": "ask"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "make test-integration*",
          "npm --prefix hubx-bender run*",
          "go -C hubx-api test*",
          "go -C hubx-gw test*",
          "gosec*",
          "govulncheck -C*",
          "git status*",
          "git diff*",
          "npm --prefix hubx-bender install*"
        ],
        "effect": "deny"
      }
    ]
  },
  "resources": [
    "file://AGENTS.md",
    "file://memory.md",
    "file://.specify/memory/constitution.md",
    "file://hubx-bender/AGENTS.md"
  ]
}

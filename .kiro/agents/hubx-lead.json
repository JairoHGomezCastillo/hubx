{
  "name": "hubx-lead",
  "description": "HUBX leader and orchestrator. Receives a story (from the backlog or described by the user), drives specify, clarify, plan, tasks, implement, analyze and the pull request with Spec Kit, delegates to the subagents and validates evidence. Single entry point of the team.",
  "model": "claude-opus-5.5",
  "prompt": "file://../agent-prompts/hubx-lead.md",
  "tools": [
    "read",
    "write",
    "shell",
    "subagent/backend-go",
    "subagent/frontend-react",
    "subagent/qa-seguridad",
    "subagent/devops"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "match": [
          "**/.env",
          "**/.env.*"
        ],
        "exclude": [
          "**/.env.example"
        ],
        "effect": "ask"
      },
      {
        "capability": "fs_write",
        "match": [
          "**"
        ],
        "exclude": [
          "**/specs/**",
          "**/backlog/**",
          "**/contracts/**",
          "**/memory.md",
          "**/README.md",
          "**/docs/**",
          "**/hubx-api/**",
          "**/hubx-gw/**",
          "**/go.work.sum",
          "**/hubx-mfe/**",
          "**/hubx-bender/**",
          "**/specs/*/qa-report.md",
          "**/Makefile",
          "**/go.work",
          "**/Dockerfile*",
          "**/compose.yaml",
          "**/docker-compose*.yml",
          "**/docker-compose*.yaml",
          "**/.github/**",
          "**/scripts/**",
          "**/deploy/**",
          "**/specs/*/deploy.md"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/specs/**",
          "**/backlog/**",
          "**/contracts/**",
          "**/memory.md",
          "**/README.md",
          "**/docs/**"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git status*",
          "git diff*",
          "git log*",
          "git checkout -b*",
          "git switch*",
          "git add*",
          "git commit*",
          "git push*",
          "gh pr create*",
          "gh pr view*",
          "make test-integration*",
          "go -C hubx-api test*",
          "go -C hubx-gw test*",
          "npm --prefix hubx-mfe run*",
          "git branch --show-current*",
          "git rev-parse*",
          "git ls-files*",
          "git fetch*",
          "gh pr list*",
          ".specify/scripts/*",
          "bash .specify/scripts/*",
          "git branch -r*",
          "git ls-remote*",
          "bash scripts/release-version.sh*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "*"
        ],
        "exclude": [
          "git status*",
          "git diff*",
          "git log*",
          "git checkout -b*",
          "git switch*",
          "git add*",
          "git commit*",
          "git push*",
          "gh pr create*",
          "gh pr view*",
          "make test-integration*",
          "go -C hubx-api test*",
          "go -C hubx-gw test*",
          "npm --prefix hubx-mfe run*",
          "git branch --show-current*",
          "git rev-parse*",
          "git ls-files*",
          "git fetch*",
          "gh pr list*",
          ".specify/scripts/*",
          "bash .specify/scripts/*",
          "git branch -r*",
          "git ls-remote*",
          "bash scripts/release-version.sh*",
          "git push origin origin/main:refs/heads/release/*",
          "go -C hubx-api build*",
          "go -C hubx-api vet*",
          "go -C hubx-api fmt*",
          "go -C hubx-api mod tidy*",
          "go -C hubx-gw build*",
          "go -C hubx-gw vet*",
          "go -C hubx-gw fmt*",
          "go -C hubx-gw mod tidy*",
          "go -C hubx-api generate*",
          "go -C hubx-api tool*",
          "go -C hubx-gw generate*",
          "go -C hubx-gw tool*",
          "npm --prefix hubx-mfe test*",
          "npm --prefix hubx-bender run*",
          "gosec*",
          "govulncheck -C*",
          "make *",
          "docker compose*",
          "docker build*",
          "npm --prefix hubx-mfe run build*",
          "curl -s*",
          "gh workflow run deploy.yml -f environment=staging *",
          "gh run list*",
          "gh run watch*",
          "gh run view*",
          "go -C hubx-api get*",
          "go -C hubx-gw get*",
          "npm --prefix hubx-mfe install*",
          "npm --prefix hubx-bender install*"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          "git push*--force*",
          "git push* -f*",
          "git push*--delete*",
          "git push* -d*",
          "git push*:*",
          "git push* main*",
          "git push* release/*",
          "git push* hotfix/*",
          "gh pr merge*",
          "git merge*",
          "gh api*"
        ],
        "effect": "deny",
        "exclude": [
          "git push origin origin/main:refs/heads/release/*"
        ]
      },
      {
        "capability": "shell",
        "match": [
          "git push origin origin/main:refs/heads/release/*"
        ],
        "effect": "ask"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/hubx-api/**",
          "**/hubx-gw/**",
          "**/go.work.sum",
          "**/hubx-mfe/**",
          "**/hubx-bender/**",
          "**/specs/*/qa-report.md",
          "**/Makefile",
          "**/go.work",
          "**/Dockerfile*",
          "**/compose.yaml",
          "**/docker-compose*.yml",
          "**/docker-compose*.yaml",
          "**/.github/**",
          "**/scripts/**",
          "**/deploy/**",
          "**/specs/*/deploy.md"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "go -C hubx-api build*",
          "go -C hubx-api test*",
          "go -C hubx-api vet*",
          "go -C hubx-api fmt*",
          "go -C hubx-api mod tidy*",
          "go -C hubx-gw build*",
          "go -C hubx-gw test*",
          "go -C hubx-gw vet*",
          "go -C hubx-gw fmt*",
          "go -C hubx-gw mod tidy*",
          "git status*",
          "git diff*",
          "go -C hubx-api generate*",
          "go -C hubx-api tool*",
          "go -C hubx-gw generate*",
          "go -C hubx-gw tool*",
          "npm --prefix hubx-mfe run*",
          "npm --prefix hubx-mfe test*",
          "make test-integration*",
          "npm --prefix hubx-bender run*",
          "gosec*",
          "govulncheck -C*",
          "make *",
          "docker compose*",
          "docker build*",
          "npm --prefix hubx-mfe run build*",
          "curl -s*",
          "gh workflow run deploy.yml -f environment=staging *",
          "gh run list*",
          "gh run watch*",
          "gh run view*"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "go -C hubx-api get*",
          "go -C hubx-gw get*",
          "npm --prefix hubx-mfe install*",
          "npm --prefix hubx-bender install*"
        ],
        "effect": "ask"
      }
    ]
  },
  "resources": [
    "file://AGENTS.md",
    "file://memory.md",
    "file://.specify/memory/constitution.md"
  ]
}
